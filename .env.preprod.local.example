# Copiez ce fichier vers .env.preprod.local et renseignez les identifiants
# du projet Supabase de PRÉPRODUCTION (fcp-preprod), jamais ceux de la
# production. .env.preprod.local n'est jamais versionné (voir .gitignore,
# couvert par la règle générale .env*).
#
# npm run test:integration lit désormais ce fichier, jamais .env.local —
# voir tests/integration/setup.ts, qui refuse de démarrer si l'URL ne
# pointe pas vers le projet de préproduction attendu, ou si elle pointe
# vers la production. .env.local (production) reste utilisé uniquement
# par l'application elle-même (npm run dev, Vercel) — inchangé par ce
# fichier.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
