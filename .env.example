# Copiez ce fichier vers .env.local et renseignez vos propres valeurs.
# .env.local n'est jamais versionné dans Git (voir .gitignore).
#
# Ces identifiants se trouvent dans votre projet Supabase :
# Project Settings > API. Créez le projet dans la région "Canada Central
# (ca-central-1)" — voir PROJECT_SPEC.md §2.

# URL de votre projet Supabase (ex. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé "publishable" (clé publique, sûre à exposer au navigateur).
# Remplace l'ancienne "anon key" — voir docs/ARCHITECTURE.md.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé "secret" (accès complet, réservée au serveur).
# Ne JAMAIS préfixer par NEXT_PUBLIC_, ne jamais exposer au navigateur.
SUPABASE_SECRET_KEY=

# URL publique complète du site (ex. https://jaimelequebec.com), sans slash
# final. Utilisée pour les URLs absolues (sitemap, canonical, Open Graph —
# voir docs/DIRECTORY.md). Optionnelle : se replie sur localhost si absente.
NEXT_PUBLIC_SITE_URL=
