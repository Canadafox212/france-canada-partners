# pour la recommandation de leur donner un emplacement dédié.
/entreprises_*.csv
/entreprises_*.json
/entreprises_*.xlsx
/france_quebec_*.csv
/france_quebec_*.xlsx
/*matching*.csv
/*matching*.xlsx
