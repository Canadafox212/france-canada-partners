# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.preprod.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Données brutes de sourcing d'entreprises (matière première du futur pipeline
# d'import, Phase 10) : volumineuses, non qualifiées, jamais versionnées.
# Voir data/README.md.
/data/raw/

# Cache local de la CLI Supabase (recréé automatiquement).
/supabase/.temp/

# Script d'application des migrations sur un projet Supabase de
# préproduction — chemins absolus propres à la machine, jamais versionné.
/scripts/preprod/
